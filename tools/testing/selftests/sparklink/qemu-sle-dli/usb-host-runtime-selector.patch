+
+static void usb_host_set_test_runtime_skip(USBHostDevice *s, unsigned count,
+                                           Error **errp)
+{
+    if (count > 2 || !s->dh || !USB_DEVICE(s)->attached ||
+        s->ddesc.idVendor != 0xffff || s->ddesc.idProduct != 0x3733 ||
+        s->allow_host_reset || s->allow_kernel_driver_detach ||
+        s->allow_one_guest_reset || s->allow_all_guest_resets ||
+        s->test_enum_reset_once || s->test_runtime_in_error_once || s->test_runtime_hold_once ||
+        s->test_runtime_held) {
+        error_setg(errp, "test skip requires idle attached WS73, all reset/"
+                   "detach opt-outs and a maximum of two original frames");
+        return;
+    }
+    s->test_runtime_skip_requested = count;
+    s->test_runtime_skip_remaining = 0;
+    s->test_runtime_skipped = 0;
+}
+
+static bool usb_host_get_test_runtime_skip_one(Object *obj, Error **errp)
+{
+    return USB_HOST_DEVICE(obj)->test_runtime_skip_requested == 1;
+}
+
+static void usb_host_set_test_runtime_skip_one(Object *obj, bool value,
+                                              Error **errp)
+{
+    usb_host_set_test_runtime_skip(USB_HOST_DEVICE(obj), value ? 1 : 0, errp);
+}
+
+static bool usb_host_get_test_runtime_skip_two(Object *obj, Error **errp)
+{
+    return USB_HOST_DEVICE(obj)->test_runtime_skip_requested == 2;
+}
+
+static void usb_host_set_test_runtime_skip_two(Object *obj, bool value,
+                                              Error **errp)
+{
+    usb_host_set_test_runtime_skip(USB_HOST_DEVICE(obj), value ? 2 : 0, errp);
 }
 
