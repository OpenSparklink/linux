+/* Test fixture only. Validate the entire real aggregate before selecting a
+ * successful, exact SDK111 Status/Complete. Never search padding/random keys,
+ * construct a reply, change bytes, or consume a malformed transfer. The
+ * normal callback still delivers every nonmatch unchanged. */
+static unsigned usb_host_test_le16(const unsigned char *p)
+{
+    return p[0] | ((unsigned)p[1] << 8);
+}
+
+static uint32_t usb_host_test_le32(const unsigned char *p)
+{
+    return p[0] | ((uint32_t)p[1] << 8) | ((uint32_t)p[2] << 16) |
+           ((uint32_t)p[3] << 24);
+}
+
+static bool usb_host_test_install_reply(const unsigned char *data, size_t size,
+                                        uint64_t opcode)
+{
+    size_t offset = 92;
+    bool ended = false, found = false;
+    unsigned n;
+
+    if ((opcode != 0x1c03 && opcode != 0x1c05) || size < 92 ||
+        size > 20 * 1024 || usb_host_test_le32(data) != 2 ||
+        usb_host_test_le32(data + 4) != size) {
+        return false;
+    }
+    for (n = 0; n < 24; n++) {
+        unsigned length = usb_host_test_le16(data + 12 + n * 2);
+        unsigned payload;
+        const unsigned char *slot, *event;
+        if (!length) {
+            ended = true;
+            continue;
+        }
+        if (ended || length < 4 || length > size - offset) {
+            return false;
+        }
+        slot = data + offset;
+        payload = usb_host_test_le16(slot + 2);
+        if (payload > length - 4) {
+            return false;
+        }
+        /* service A / queue 8, a2 event + exact four-byte command result. */
+        event = slot + 4;
+        if ((slot[0] >> 4) == 10 && slot[1] == 8 && payload == 9 &&
+            event[0] == 0xa2 &&
+            (usb_host_test_le16(event + 1) == 1 ||
+             usb_host_test_le16(event + 1) == 2) &&
+            usb_host_test_le16(event + 3) == 4 &&
+            usb_host_test_le16(event + 5) == opcode &&
+            event[7] == 1 && event[8] == 0) {
+            found = true;
+        }
+        offset += length;
+    }
+    return found && offset == size;
+}
