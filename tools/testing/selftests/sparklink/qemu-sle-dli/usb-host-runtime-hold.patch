+static void LIBUSB_CALL usb_host_req_complete_data(struct libusb_transfer *xfer);
+
+/* QMP, timers and libusb callbacks serialize under BQL. Clear timer/identity
+ * before completing/freeing, so cancellation/close cannot replay this request. */
+static bool usb_host_test_clear_hold(USBHostDevice *s, USBHostRequest *r)
+{
+    if (s->test_runtime_held != r) {
+        return false;
+    }
+    s->test_runtime_held = NULL;
+    timer_del(s->test_runtime_hold_timer);
+    timer_free(s->test_runtime_hold_timer);
+    s->test_runtime_hold_timer = NULL;
+    return true;
+}
+
+static void usb_host_test_release_hold(USBHostDevice *s, bool bounded)
+{
+    USBHostRequest *r = s->test_runtime_held;
+    if (!r) {
+        return;
+    }
+    usb_host_test_clear_hold(s, r);
+    s->test_runtime_releases++;
+    s->test_runtime_bounded_releases += bounded;
+    error_report("WS73_TEST_RUNTIME_HOLD_RELEASE: dev %d:%d bytes=%d "
+                 "bounded=%d releases=%" PRIu64,
+                 s->bus_num, s->addr, r->xfer->actual_length,
+                 bounded, s->test_runtime_releases);
+    /* Original successful xfer/buffer, unchanged, via the normal callback. */
+    usb_host_req_complete_data(r->xfer);
+}
+
+static void usb_host_test_hold_timeout(void *opaque)
+{
+    usb_host_test_release_hold(opaque, true);
+}
+
