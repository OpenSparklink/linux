+
+static bool usb_host_get_test_runtime_hold(Object *obj, Error **errp)
+{
+    return USB_HOST_DEVICE(obj)->test_runtime_hold_once;
+}
+
+static bool usb_host_get_test_runtime_held(Object *obj, Error **errp)
+{
+    return USB_HOST_DEVICE(obj)->test_runtime_held != NULL;
+}
+
+static void usb_host_set_test_runtime_hold(Object *obj, bool value, Error **errp)
+{
+    USBHostDevice *s = USB_HOST_DEVICE(obj);
+    if (value && (!s->dh || !USB_DEVICE(s)->attached ||
+                  s->ddesc.idVendor != 0xffff || s->ddesc.idProduct != 0x3733 ||
+                  s->allow_host_reset || s->allow_kernel_driver_detach ||
+                  s->allow_one_guest_reset || s->allow_all_guest_resets ||
+                  s->test_runtime_in_error_once || s->test_runtime_hold_once ||
+                  s->test_runtime_held)) {
+        error_setg(errp, "test hold requires attached WS73, all reset/detach "
+                   "opt-outs and no pending hold/error");
+        return;
+    }
+    s->test_runtime_hold_once = value;
+}
+
+static bool usb_host_get_test_runtime_release(Object *obj, Error **errp)
+{
+    return false; /* pulse */
+}
+
+static void usb_host_set_test_runtime_release(Object *obj, bool value, Error **errp)
+{
+    USBHostDevice *s = USB_HOST_DEVICE(obj);
+    if (!value) {
+        return;
+    }
+    if (!s->test_runtime_held) {
+        error_setg(errp, "test release requires an actual held transfer");
+        return;
+    }
+    usb_host_test_release_hold(s, false);
 }
 
