     rc = libusb_get_active_config_descriptor(s->dev, &conf);
     if (rc != 0) {
@@ -1769,6 +1787,10 @@
 #endif
     DEFINE_PROP_UINT32("isobufs",  USBHostDevice, iso_urb_count,    4),
